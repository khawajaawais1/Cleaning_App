{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=YOUR_DB;Persist Security Info=False;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "Happy2CleanAPI",
    "Audiences": [ "Happy2CleanAdmin", "Happy2CleanWorker", "Happy2CleanCustomer" ],
    "ExpirationHours": 24
  },
  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_BLOB_KEY==;EndpointSuffix=core.windows.net",
    "ContainerName": "worker-documents"
  },
  "ServiceBus": {
    "ConnectionString": "Endpoint=sb://YOUR_SERVICEBUS.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_SERVICE_BUS_KEY=",
    "LocationQueueName": "worker-location-updates"
  },
  "WebPubSub": {
    "ConnectionString": "Endpoint=https://YOUR_PUBSUB.webpubsub.azure.com;AccessKey=YOUR_PUBSUB_KEY=;Version=1.0;",
    "HubName": "jobtracking"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "Stripe": {
    "PublishableKey": "pk_test_YOUR_STRIPE_PUBLISHABLE_KEY",
    "SecretKey": "sk_test_YOUR_STRIPE_SECRET_KEY"
  }
}
