{
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "Happy2CleanAPI",
    "Audiences": [ "Happy2CleanAdmin", "Happy2CleanWorker", "Happy2CleanCustomer" ],
    "ExpirationHours": 24
  },
  "BlobStorage": {
    "ConnectionString": "YOUR_BLOB_STORAGE_CONNECTION_STRING",
    "ContainerName": "worker-documents"
  },
  "ServiceBus": {
    "ConnectionString": "YOUR_SERVICE_BUS_CONNECTION_STRING",
    "LocationQueueName": "worker-location-updates"
  },
  "WebPubSub": {
    "ConnectionString": "YOUR_WEB_PUBSUB_CONNECTION_STRING",
    "HubName": "jobtracking"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "Stripe": {
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY",
    "SecretKey": "YOUR_STRIPE_SECRET_KEY"
  }
}
