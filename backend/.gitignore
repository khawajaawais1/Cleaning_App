## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider files
.idea/
*.sln.iml
*.sw*

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# Build results
bin/
obj/
!.gitkeep

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet Packages
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Local dev settings — never commit real secrets
appsettings.Development.json
appsettings.local.json
appsettings.*.local.json

# Entity Framework migrations (optional)
# Migrations/

# OS files
.DS_Store
Thumbs.db

# Node modules (if using npm/yarn for frontend)
node_modules/
npm-debug.log
yarn-error.log
