{
  "_comment": "Copy this file to appsettings.Development.json and fill in your local values. Never commit appsettings.Development.json.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Happy2CleanDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS",
    "Issuer": "Happy2CleanAPI",
    "Audiences": [ "Happy2CleanAdmin", "Happy2CleanWorker", "Happy2CleanCustomer" ],
    "ExpirationHours": 24
  },
  "Google": {
    "ClientId": "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "worker-documents"
  },
  "ServiceBus": {
    "ConnectionString": "REPLACE_WITH_AZURE_SERVICE_BUS_CONNECTION_STRING",
    "LocationQueueName": "worker-location-updates"
  },
  "Stripe": {
    "PublishableKey": "pk_test_REPLACE_WITH_STRIPE_TEST_KEY",
    "SecretKey": "sk_test_REPLACE_WITH_STRIPE_TEST_KEY"
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
